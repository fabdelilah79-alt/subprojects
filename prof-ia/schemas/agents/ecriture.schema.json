{
  "type": "object",
  "properties": {
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "id du beat (celui de l'agent voix)."
          },
          "actions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "ecrire"
                    },
                    "ancre": {
                      "type": "string",
                      "description": "Mot ou groupe de mots recopié À L'IDENTIQUE depuis le texte_dit du beat."
                    },
                    "texte": {
                      "type": "string",
                      "description": "Ce qui s'écrit au tableau (court)."
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "titre",
                        "normal",
                        "a_retenir"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ancre",
                    "texte",
                    "style"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "formule"
                    },
                    "ancre": {
                      "type": "string",
                      "description": "Mot ou groupe de mots recopié À L'IDENTIQUE depuis le texte_dit du beat."
                    },
                    "latex": {
                      "type": "string",
                      "description": "Formule en LaTeX (\\ce{} pour la chimie)."
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "a_retenir"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "ancre",
                    "latex",
                    "style"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "dessiner"
                    },
                    "ancre": {
                      "type": "string",
                      "description": "Mot ou groupe de mots recopié À L'IDENTIQUE depuis le texte_dit du beat."
                    },
                    "element": {
                      "type": "string",
                      "description": "Nom d'un élément de la bibliothèque."
                    },
                    "parametres": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nom": {
                            "type": "string",
                            "description": "Nom du paramètre."
                          },
                          "valeur": {
                            "type": "string",
                            "description": "Valeur (texte ; les nombres sont convertis)."
                          }
                        },
                        "required": [
                          "nom",
                          "valeur"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "ancre",
                    "element",
                    "parametres"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "actions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "beats"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ce qui s'écrit et se dessine, beat par beat (agent écriture)"
}
